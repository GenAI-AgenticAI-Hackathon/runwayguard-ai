# RunwayGuard AI — Environment Configuration Example
# Copy this file to .env and insert your personal API keys.
# NEVER commit the actual .env file to source control.

# Required for Live Model Execution (Get a key at https://console.groq.com)
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# Optional: Run in fully offline mock mode without calling external APIs (true/false)
RUNWAYGUARD_MOCK=false

# Optional Model Overrides
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AGENT_MODEL=llama3-70b-8192
REPORT_MODEL=llama3-70b-8192
