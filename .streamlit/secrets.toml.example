# ── Streamlit Cloud Secrets Template ───────────────────────────────────────────
# Copy this file to .streamlit/secrets.toml and fill in your real values.
# NEVER commit secrets.toml to Git.
#
# Streamlit Cloud will automatically inject these from the Secrets panel in your
# app settings (Settings → Secrets).

GROQ_API_KEY = "gsk_your_groq_api_key_here"
